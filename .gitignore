package-lock.json
*.js
node_modules
bin/
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets — these carry live credentials (PlayFab secret keys, MySQL and admin
# passwords) and, in chain-playfab/.env, a blockchain PRIVATE_KEY. Keep them out
# of git. .env.example files are templates with no real values and stay tracked.
.env
**/.env
*.env
!**/.env.example
.secret
**/.secret
*.pem
*.p12
*.keystore
deploy/*.tar

# Local runtime output of scripts/dev-up.sh (service logs, and exports such as
# orphan-account lists that hold PlayFab IDs), the IDE's project folder, and the
# Codex instruction stub.
scripts/.dev-logs/
.idea/
AGENTS.md

# token for scripts/backend-logs.sh (LOGS_TOKEN in the CapRover apps)
scripts/.logs-token

# left by a pnpm install run at the repo root; the Studio client keeps its own
# pnpm files in studio/, and the root is an npm package
/pnpm-lock.yaml
/pnpm-workspace.yaml

# GDD working files of the dcl-gdd skill: only design/gdd.md is the submission,
# and the Creator Success reviewers get access to this repo
design/decisions.md
design/ideas.md
design/notes.md
design/implementation-notes.md
design/hypothesis-log.md
design/0[0-9]-*/
design/gdd.html
