package-lock.json
# ...except these two, which are force-tracked because a BUILD NEEDS THEM.
# A fresh resolve of scene/package.json does not build: @dcl/asset-packs comes
# out at 2.26.0, which imports "@dcl/sdk/text-codec", and the pinned
# @dcl/sdk@7.23.3 has no such subpath, so esbuild fails. The lockfile holds it
# at 2.15.3, which builds. CI therefore runs `npm ci`, not `npm install`
# (.github/workflows/ci.yml), and so do deploy/*.Dockerfile — those used to
# rely on the deploy packing the working tree, which is why §16 said to copy
# the gitignored lockfiles in before deploying from a worktree.
# The other services' lockfiles (web/, server/, chain-playfab/) are still
# ignored and still need that copy.
!/package-lock.json
!/scene/package-lock.json
*.js
node_modules
bin/
# Reference docs sdk-commands drops beside the scene on every build.
scene/dclcontext/
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets — these carry live credentials (PlayFab secret keys, MySQL and admin
# passwords) and, in chain-playfab/.env, a blockchain PRIVATE_KEY. Keep them out
# of git. .env.example files are templates with no real values and stay tracked.
.env
**/.env
*.env
!**/.env.example
.secret
**/.secret
*.pem
*.p12
*.keystore
deploy/*.tar

# Local runtime output of scripts/dev-up.sh (service logs, and exports such as
# orphan-account lists that hold PlayFab IDs), the IDE's project folder, and the
# Codex instruction stub.
scripts/.dev-logs/
.idea/
AGENTS.md

# token for scripts/backend-logs.sh (LOGS_TOKEN in the CapRover apps)
scripts/.logs-token

# left by a pnpm install run at the repo root; the Studio client keeps its own
# pnpm files in studio/, and the root is an npm package
/pnpm-lock.yaml
/pnpm-workspace.yaml

# GDD working files of the dcl-gdd skill: only design/gdd.md is the submission,
# and the Creator Success reviewers get access to this repo
design/decisions.md
design/ideas.md
design/notes.md
design/implementation-notes.md
design/hypothesis-log.md
design/0[0-9]-*/
design/gdd.html

# The SDK6 build of the expression storage (jsep inlined): the game server
# resolves it before the .ts stub (ts-node, preferTsExts off). It is not
# generated here, so it must travel with the repo, or a clean worktree deploys
# a server whose switches and trigger areas never change anything.
!lib/expression-storage/_expression-storage.js

# Local copy of the Discord webhook URLs and other deploy secrets: never commit.
deploy/*.env

# The skills installer keeps its own copy of each package here and copies
# the skills into .claude/skills, which is what Claude Code reads. Only the
# copies and skills-lock.json are tracked; this store is restored with
# `npx skills experimental_install`.
.agents/
